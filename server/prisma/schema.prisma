generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                  String          @id @default(cuid())
  username            String          @unique
  email               String?         @unique
  passwordHash        String
  createdAt           DateTime        @default(now())
  biweeklyAnchorWeekStart DateTime?
  standardSlots       StandardSlot[]
  customWeeks         CustomWeek[]
  ownedGroups         PlannerGroup[]  @relation("GroupOwner")
  memberships         GroupMember[]
  groupStandardSlots  GroupStandardSlot[]
  groupCustomSlots    GroupCustomSlot[]
  biweeklySlots       BiweeklySlot[]
  passwordResetTokens PasswordResetToken[]
}

model StandardSlot {
  id        String  @id @default(cuid())
  userId    String
  day       Int
  slot      Int
  available Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, slot])
  @@index([userId])
}

model CustomWeek {
  id        String       @id @default(cuid())
  userId    String
  weekStart DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots     CustomSlot[]

  @@unique([userId, weekStart])
}

model CustomSlot {
  id           String     @id @default(cuid())
  customWeekId String
  day          Int
  slot         Int
  available    Boolean
  customWeek   CustomWeek @relation(fields: [customWeekId], references: [id], onDelete: Cascade)

  @@unique([customWeekId, day, slot])
}

model PlannerGroup {
  id        String        @id @default(cuid())
  name      String
  color     String        @default("#5667df")
  ownerId   String
  createdAt DateTime      @default(now())
  owner     User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   GroupMember[]
  standardSlots GroupStandardSlot[]
  customSlots GroupCustomSlot[]
  biweeklySlots BiweeklySlot[]
  groupBiweeklySchedules GroupBiweeklySchedule[]
}

model GroupMember {
  id      String       @id @default(cuid())
  groupId String
  userId  String
  group   PlannerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


model GroupStandardSlot {
  id      String       @id @default(cuid())
  userId  String
  groupId String
  day     Int
  slot    Int
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   PlannerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId, day, slot])
  @@index([userId, groupId])
}

model GroupCustomSlot {
  id        String       @id @default(cuid())
  userId    String
  groupId   String
  weekStart DateTime
  day       Int
  slot      Int
  available Boolean
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     PlannerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId, weekStart, day, slot])
  @@index([userId, groupId, weekStart])
}

model GroupBiweeklySchedule {
  id      String              @id @default(cuid())
  groupId String
  parity  Int
  group   PlannerGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  slots   GroupBiweeklySlot[]

  @@unique([groupId, parity])
  @@index([groupId, parity])
}

model GroupBiweeklySlot {
  id         String               @id @default(cuid())
  scheduleId String
  day        Int
  slot       Int
  schedule   GroupBiweeklySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, day, slot])
}

model BiweeklySlot {
  id        String        @id @default(cuid())
  userId    String
  groupId   String?
  parity    Int
  day       Int
  slot      Int
  available Boolean
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     PlannerGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, parity, day, slot])
  @@index([userId, parity])
  @@index([groupId])
}

model SessionStore {
  sid    String   @id
  sess   String
  expire DateTime

  @@index([expire])
  @@map("user_sessions")
}
