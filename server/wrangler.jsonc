{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "availability-planner-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "cpu_ms": 10
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "availability-planner",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_URL": "https://your-client.pages.dev",
    "CORS_ORIGINS": "https://your-client.pages.dev",
    "SESSION_COOKIE_SAME_SITE": "none",
    "SESSION_COOKIE_SECURE": "true",
    "MAIL_FROM": "Availability Planner <no-reply@example.com>"
  },
  "observability": {
    "enabled": true
  }
}
