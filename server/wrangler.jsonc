{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "availability-planner-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "availability-planner",
      "database_id": "d44afa4d-b4ca-4088-9815-42924bf83354",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "CORS_ORIGINS": "https://commontime.guidomors.workers.dev",
    "SESSION_COOKIE_SAME_SITE": "none",
    "SESSION_COOKIE_SECURE": "true"
  },
  "observability": {
    "enabled": true
  }
}
