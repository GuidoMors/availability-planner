{
  "name": "availability-planner-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "wrangler dev",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "prebuild": "prisma generate",
    "build": "wrangler deploy --dry-run",
    "predeploy": "prisma generate",
    "deploy": "wrangler deploy",
    "db:generate": "prisma generate",
    "db:migrate:local": "wrangler d1 migrations apply availability-planner --local",
    "db:migrate:remote": "wrangler d1 migrations apply availability-planner --remote",
    "db:export-sqlite": "node scripts/export-sqlite.mjs",
    "db:recovery-key": "node scripts/create-recovery-key-sql.mjs"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/node": "^22.13.10",
    "prisma": "^7.10.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.151.3"
  }
}
